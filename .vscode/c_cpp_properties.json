{
    "configurations": [
        {
            "name": "STM32F103RC - Keil ARMCC5",
            "includePath": [
                "${workspaceFolder}/Core/Inc",
                "${workspaceFolder}/MDK-ARM/User",
                "${workspaceFolder}/MDK-ARM/RTE/_OB_ROBOT",
                "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc",
                "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc/Legacy",
                "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
                "${workspaceFolder}/Drivers/CMSIS/Include",
                "D:/keil5/Core/ARM/ARMCC/include",
                "D:/keil5/Core/ARM/ARMCC/include/rw"
            ],
            "defines": [
                "USE_HAL_DRIVER",
                "STM32F103xE",
                "__CC_ARM",
                "__ARMCC_VERSION=5060960",
                "__arm__",
                "__align(x)=",
                "__asm(x)=",
                "__forceinline=",
                "__inline=",
                "__packed=",
                "__weak=",
                "__attribute__(x)=",
                "__declspec(x)="
            ],
            "compilerPath": "",
            "cStandard": "c99",
            "cppStandard": "c++14",
            "intelliSenseMode": "windows-gcc-arm",
            "browse": {
                "path": [
                    "${workspaceFolder}/Core/Inc",
                    "${workspaceFolder}/Core/Src",
                    "${workspaceFolder}/MDK-ARM/User",
                    "${workspaceFolder}/Drivers/STM32F1xx_HAL_Driver/Inc",
                    "${workspaceFolder}/Drivers/CMSIS/Device/ST/STM32F1xx/Include",
                    "${workspaceFolder}/Drivers/CMSIS/Include"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ],
    "version": 4
}
